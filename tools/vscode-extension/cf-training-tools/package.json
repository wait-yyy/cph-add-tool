{
    "name": "cf-training-tools",
    "displayName": "CF Training Tools",
    "description": "Codeforces 训练辅助：活动栏面板（当前题单/按钮）、周题单（CF+AtCoder+洛谷）、赛后复盘、题面 Markdown",
    "version": "0.6.1",
    "publisher": "waityyy",
    "repository": {
        "type": "git",
        "url": "https://gitcode.com/2403_86825600/cph-add-tool.git"
    },
    "homepage": "https://gitcode.com/2403_86825600/cph-add-tool#readme",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "cfTrainingSidebar",
                    "title": "CF 训练",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "cfTrainingSidebar": [
                {
                    "type": "webview",
                    "id": "cfTraining.main",
                    "name": "训练面板"
                }
            ]
        },
        "commands": [
            {
                "command": "cfTraining.menu",
                "title": "训练菜单",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.plan",
                "title": "生成/刷新周题单（CF+AtCoder+洛谷）",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.pullContest",
                "title": "抓取整场比赛（Codeforces/AtCoder/洛谷/牛客）",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.openPlan",
                "title": "打开完整周题单",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.openRedo",
                "title": "打开重做队列",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.aiHint",
                "title": "AI 提示（当前题）",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.aiAsk",
                "title": "问 AI（当前题）",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.aiReview",
                "title": "AI 复盘（选比赛）",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.aiTranslate",
                "title": "AI 翻译当前题面",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.aiConfig",
                "title": "设置 AI API",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.aiTest",
                "title": "测试 AI 连接",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.aiSettings",
                "title": "在 VS Code 设置中编辑 AI 配置",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.reviewLatest",
                "title": "复盘最近一场",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.reviewInput",
                "title": "复盘指定比赛（输入 contestId）",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.statementOpen",
                "title": "打开当前题目题面预览",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.statementNow",
                "title": "重新抓取当前题目题面",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.regenerateAll",
                "title": "重新生成全部题面 md",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.samples",
                "title": "编译并跑样例（cp.ps1）",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.build",
                "title": "只编译（cp.ps1）",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.setHandle",
                "title": "设置 Codeforces handle",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.patchStatus",
                "title": "查看 CPH 补丁状态",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.patchApply",
                "title": "重新打 CPH 补丁",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.patchRevert",
                "title": "回滚 CPH 补丁",
                "category": "CF 训练"
            },
            {
                "command": "cfTraining.openDoc",
                "title": "打开训练手册",
                "category": "CF 训练"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "cfTraining.statementOpen",
                    "when": "resourceExtname == .cpp",
                    "group": "navigation@9"
                }
            ]
        },
        "configuration": {
            "title": "CF 训练 / AI",
            "properties": {
                "cf-training-tools.ai.baseUrl": {
                    "type": "string",
                    "default": "https://api.deepseek.com",
                    "description": "OpenAI 兼容 API 的 baseUrl（脚本调用时同步写入 training/ai-config.json）"
                },
                "cf-training-tools.ai.model": {
                    "type": "string",
                    "default": "deepseek-flash",
                    "description": "模型名（DeepSeek 当前可选 deepseek-flash / deepseek-v4-pro）"
                },
                "cf-training-tools.ai.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "API Key（只保存在本机；不要提交/分享）"
                },
                "cf-training-tools.ai.temperature": {
                    "type": "number",
                    "default": 0.3,
                    "description": "采样温度（越低越稳定）"
                },
                "cf-training-tools.autoPreview": {
                    "type": "boolean",
                    "default": true,
                    "description": "拉题时自动打开题面预览（只对当前正在编辑的那道题生效；整场拉题不会弹一堆。设为 false 可彻底关闭）"
                }
            }
        }
    },
    "keywords": [
        "codeforces",
        "atcoder",
        "luogu",
        "training",
        "competitive programming"
    ]
}
