{
    "name":  "cf-training-tools",
    "displayName":  "CF Training Tools",
    "description":  "Codeforces 训练辅助：活动栏面板（当前题单/按钮）、周题单（CF+AtCoder+洛谷）、赛后复盘、题面 Markdown",
    "version":  "0.9.8",
    "publisher":  "waityyy",
    "repository":  {
                       "type":  "git",
                       "url":  "https://gitcode.com/2403_86825600/cph-add-tool.git"
                   },
    "homepage":  "https://gitcode.com/2403_86825600/cph-add-tool#readme",
    "engines":  {
                    "vscode":  "^1.80.0"
                },
    "categories":  [
                       "Other"
                   ],
    "activationEvents":  [
                             "onStartupFinished"
                         ],
    "main":  "./extension.js",
    "contributes":  {
                        "viewsContainers":  {
                                                "activitybar":  [
                                                                    {
                                                                        "id":  "cfTrainingSidebar",
                                                                        "title":  "CF 训练",
                                                                        "icon":  "media/icon.svg"
                                                                    }
                                                                ]
                                            },
                        "views":  {
                                      "cfTrainingSidebar":  [
                                                                {
                                                                    "type":  "webview",
                                                                    "id":  "cfTraining.main",
                                                                    "name":  "训练面板"
                                                                },
                                                                {
                                                                    "type":  "webview",
                                                                    "id":  "cfTraining.samples",
                                                                    "name":  "样例自测"
                                                                }
                                                            ]
                                  },
                        "commands":  [
                                         {
                                             "command":  "cfTraining.menu",
                                             "title":  "训练菜单",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.plan",
                                             "title":  "生成/刷新周题单（CF+AtCoder+洛谷）",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.pullContest",
                                             "title":  "抓取整场比赛（Codeforces/AtCoder/洛谷/牛客）",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.pullProblem",
                                             "title":  "抓取单个题目",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.cfLogin",
                                             "title":  "设置 CF 登录 Cookie（Gym/私有比赛）",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.cfLoginCheck",
                                             "title":  "检查 CF 登录状态",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.cfLogout",
                                             "title":  "清除 CF 登录 Cookie",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.pullTemplate",
                                             "title":  "设置拉题初始模板",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.openPlan",
                                             "title":  "打开完整周题单",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.openRedo",
                                             "title":  "打开重做队列",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.aiHint",
                                             "title":  "AI 提示（当前题）",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.aiAsk",
                                             "title":  "问 AI（当前题）",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.aiReview",
                                             "title":  "AI 复盘（选比赛）",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.aiTranslate",
                                             "title":  "AI 翻译当前题面",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.aiConfig",
                                             "title":  "设置 AI API",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.aiTest",
                                             "title":  "测试 AI 连接",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.aiSettings",
                                             "title":  "在 VS Code 设置中编辑 AI 配置",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.reviewLatest",
                                             "title":  "复盘最近一场",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.reviewInput",
                                             "title":  "复盘指定比赛（输入 contestId）",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.statementOpen",
                                             "title":  "打开当前题目题面预览",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.statementNow",
                                             "title":  "重新抓取当前题目题面",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.samples",
                                             "title":  "编译并跑样例（cp.ps1）",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.build",
                                             "title":  "只编译（cp.ps1）",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.setHandle",
                                             "title":  "设置 Codeforces handle",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.openDoc",
                                             "title":  "打开训练手册",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.sampleTests",
                                             "title":  "样例自测（计分）",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "title":  "登录 Codeforces（Cookie）",
                                             "command":  "cfTraining.loginCodeforces",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "title":  "登录 洛谷（Cookie）",
                                             "command":  "cfTraining.loginLuogu",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "title":  "登录 牛客（Cookie）",
                                             "command":  "cfTraining.loginNowcoder",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "title":  "登录 AtCoder（Cookie）",
                                             "command":  "cfTraining.loginAtcoder",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "title":  "检查各平台账号状态",
                                             "command":  "cfTraining.accountStatus",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "command":  "cfTraining.submit",
                                             "title":  "提交当前题到对应 OJ",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "title":  "清除 OJ Cookie（选择平台）",
                                             "command":  "cfTraining.clearCookie",
                                             "category":  "CF 训练"
                                         },
                                         {
                                             "title":  "打开 Cookie 保存目录",
                                             "command":  "cfTraining.openCookieFolder",
                                             "category":  "CF 训练"
                                         }
                                     ],
                        "menus":  {
                                      "explorer/context":  [
                                                               {
                                                                   "command":  "cfTraining.statementOpen",
                                                                   "when":  "resourceExtname == .cpp",
                                                                   "group":  "navigation@9"
                                                               }
                                                           ]
                                  },
                        "configuration":  {
                                              "title":  "CF 训练 / AI",
                                              "properties":  {
                                                                 "cf-training-tools.ai.baseUrl":  {
                                                                                                      "type":  "string",
                                                                                                      "default":  "https://api.deepseek.com",
                                                                                                      "description":  "OpenAI 兼容 API 的 baseUrl（脚本调用时同步写入 training/ai-config.json）"
                                                                                                  },
                                                                 "cf-training-tools.ai.model":  {
                                                                                                    "type":  "string",
                                                                                                    "default":  "deepseek-flash",
                                                                                                    "description":  "模型名（DeepSeek 当前可选 deepseek-flash / deepseek-v4-pro）"
                                                                                                },
                                                                 "cf-training-tools.ai.apiKey":  {
                                                                                                     "type":  "string",
                                                                                                     "default":  "",
                                                                                                     "description":  "API Key（只保存在本机；不要提交/分享）"
                                                                                                 },
                                                                 "cf-training-tools.ai.temperature":  {
                                                                                                          "type":  "number",
                                                                                                          "default":  0.3,
                                                                                                          "description":  "采样温度（越低越稳定）"
                                                                                                      },
                                                                 "cf-training-tools.autoPreview":  {
                                                                                                       "type":  "boolean",
                                                                                                       "default":  true,
                                                                                                       "description":  "拉题时自动打开题面预览（只对当前正在编辑的那道题生效；整场拉题不会弹一堆。设为 false 可彻底关闭）"
                                                                                                   },
                                                                 "cf-training-tools.forceTwoColumnSplit":  {
                                                                                                               "type":  "boolean",
                                                                                                               "default":  true,
                                                                                                               "description":  "打开题目时强制两栏布局：左侧 .cpp、右侧题面 .md 预览（设为 false 则不调整布局）"
                                                                                                           },
                                                                 "cf-training-tools.autoStatementPreview":  {
                                                                                                                "type":  "boolean",
                                                                                                                "default":  true,
                                                                                                                "description":  "打开有同名 .md 的 .cpp 时，自动在侧边分屏打开题面预览"
                                                                                                            },
                                                                 "cf-training-tools.pull.template":  {
                                                                                                         "type":  "string",
                                                                                                         "default":  "new.cpp",
                                                                                                         "description":  "拉题时用于生成新 .cpp 的初始模板（绝对路径，或相对仓库根的路径，例如 new.cpp / templates/new.cpp）"
                                                                                                     }
                                                             }
                                          }
                    },
    "keywords":  [
                     "codeforces",
                     "atcoder",
                     "luogu",
                     "training",
                     "competitive programming"
                 ]
}